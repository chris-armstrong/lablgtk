(include_subdirs unqualified)

; ---- Shared test-support library (no gir_gen.exe dependency) ---------------
; Infrastructure helpers and factories used by both test stanzas.
; (wrapped false) keeps module names unqualified (Helpers, C_parser, etc.)

(library
 (name test_gir_gen_helpers)
 (wrapped false)
 (package gir_gen)
 (modules
  helpers
  pipeline_tmp
  c_compiler
  c_ast
  c_parser
  c_validation
  ml_ast_helpers
  ml_validation
  layer2_helpers
  type_factory
  override_factory
  fixtures)
 (libraries gir_gen_lib alcotest ppxlib ppxlib.astlib sexplib re unix containers fmt compiler-libs))
; These can run even if gir_gen.exe fails to build.

(test
 (name test_gir_gen)
 (package gir_gen)
 (modules
  test_gir_gen
  ; Layer 0 — C Stub Generation
  generation_tests
  header_naming_tests
  header_generation_tests
  c_validation_tests
  nullable_tests
  error_handling_tests
  out_params_tests
  array_tests
  record_macro_tests
  list_conv_tests
  type_conversion_tests
  c_stub_version_guard_tests
  ; Layer 1 — ML Generation
  type_definition_tests
  external_decl_tests
  signature_tests
  ; Constants generation (pure unit)
  constant_code_tests
  ; Layer 2 — Class Generation (pure unit/pipeline)
  method_wrapper_tests
  constructor_wrapper_tests
  signal_wrapper_tests
  signal_marshaller_tests
  ; Interface — parsing only (pure unit, no subprocess)
  parsing_tests
  ; Cross-namespace (pure unit/pipeline)
  no_external_enum_decls_tests
  no_external_bitfield_decls_tests
  dependency_includes_tests
  dependency_exclusion_tests
  c_stub_include_tests
  classify_type_tests
  header_pipeline_tests
  compilation_tests
  constant_references_tests
  ; Override system
  types_tests
  parser_tests
  apply_tests
  extractor_tests
  apply_with_parsed_gir_tests
  pipeline_tests
  version_guard_tests
  enum_member_version_tests)
 (deps
  (source_tree %{workspace_root}/gir))
 (action
  (setenv
   "GIR_DATA_DIR"
   "%{workspace_root}/gir"
   (run %{test})))
 (preprocess
  (pps ppx_sexp_conv))
 (libraries
  test_gir_gen_helpers
  gir_gen_lib
  alcotest
  ppxlib
  ppxlib.astlib
  sexplib
  re
  unix
  containers
  fmt
  compiler-libs))

; ---- Integration tests (require gir_gen.exe) --------------------------------
; Spawns gir_gen.exe as a subprocess or reads its output artefacts.

(test
 (name test_gir_gen_integration)
 (package gir_gen)
 (modules
  test_gir_gen_integration
  ; Layer 2 — interface tests that call gir_gen.exe
  interface_inheritance_tests
  interface_method_types_tests
  ; Interface — from_gobject C stub generation (calls gir_gen.exe)
  from_gobject_tests
  ; Cross-namespace regression test (calls gir_gen.exe)
  c_stub_tests
  ; Integration — end-to-end subprocess tests
  gir_parsing_tests
  widget_generation_tests
  nullable_generation_tests
  cli_tests
  gir_parser_tests
  signals_tests
  enums_tests
  records_tests
  properties_tests
  edge_cases_tests
  ; Signal corpus — uses cross-namespace reference files produced by
  ; gir_gen.exe references rules in corpus/dune.
  signal_corpus
  signal_corpus_tests)
 (deps
  %{exe:../bin/gir_gen.exe}
  (source_tree %{workspace_root}/gir)
  corpus/signal_corpus_baseline.sexp
  corpus/cairo-references.sexp
  corpus/gio-references.sexp
  corpus/gdk-references.sexp
  corpus/graphene-references.sexp
  corpus/gdkpixbuf-references.sexp
  corpus/pango-references.sexp
  corpus/gsk-references.sexp
  corpus/pangocairo-references.sexp
  corpus/gtk-references.sexp)
 (action
  (setenv
   "GIR_DATA_DIR"
   "%{workspace_root}/gir"
   (run %{test})))
 (preprocess
  (pps ppx_sexp_conv))
 (libraries
  test_gir_gen_helpers
  gir_gen_lib
  alcotest
  ppxlib
  ppxlib.astlib
  sexplib
  re
  unix
  containers
  fmt
  compiler-libs))
